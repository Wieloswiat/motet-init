{
	"name": "@motet/web",
	"description": "Motet's web client: SvelteKit, server-rendered against the AppView.",
	"private": true,
	"license": "MIT",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && panda codegen",
		"check": "svelte-kit sync && panda codegen && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:client": "vitest run --project client",
		"test:e2e": "playwright test",
		"test:mutation": "stryker run && node ../../tools/check-mutation-report.mjs reports/mutation/mutation.json"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.24.3",
		"@ipld/dag-cbor": "^10.0.2",
		"@motet/design": "workspace:*",
		"@motet/lexicons": "workspace:*"
	},
	"devDependencies": {
		"@noble/curves": "^1.9.7",
		"@pandacss/dev": "^2.2.0",
		"@pandacss/preset-base": "2.2.0",
		"@playwright/test": "^1.60.0",
		"@stryker-mutator/core": "10.1.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#styled/*": "./styled-system/*/index.js"
	}
}
