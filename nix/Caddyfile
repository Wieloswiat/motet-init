{
	# Certificates are generated by tls-setup, not requested from a public CA.
	auto_https off
	admin off
	persist_config off
}

(local_tls) {
	bind {$MOTET_CADDY_BIND:127.0.0.1}
	tls {$MOTET_TLS_CERT} {$MOTET_TLS_KEY}
}

(forwarded_headers) {
	# None of the incoming proxy headers may assert the browser's identity.
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto https
	header_up X-Forwarded-Port 443
	header_up -Forwarded
}

# Match fixed services before the World fallback. Grouping the PDS and World
# wildcards into separate sites let the World route shadow pds.motet.test.
https://motet.test, https://*.motet.test, https://*.pds.motet.test {
	import local_tls

	@web host motet.test
	handle @web {
		@api path /xrpc/* /oauth/*
		handle @api {
			reverse_proxy 127.0.0.1:2583 {
				import forwarded_headers
			}
		}
		handle {
			reverse_proxy {$MOTET_WEB_UPSTREAM:127.0.0.1:4174} {
				import forwarded_headers
			}
		}
	}

	@pds host pds.motet.test *.pds.motet.test
	handle @pds {
		reverse_proxy 127.0.0.1:4800 {
			import forwarded_headers
		}
	}

	@plc host plc.motet.test
	handle @plc {
		reverse_proxy 127.0.0.1:2582 {
			import forwarded_headers
		}
	}

	@relay host relay.motet.test
	handle @relay {
		reverse_proxy 127.0.0.1:2470 {
			import forwarded_headers
		}
	}

	@tap host tap.motet.test
	handle @tap {
		reverse_proxy 127.0.0.1:2480 {
			import forwarded_headers
		}
	}

	handle {
		reverse_proxy 127.0.0.1:2584 {
			import forwarded_headers
		}
	}
}
