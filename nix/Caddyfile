{
	# Certificates are generated by tls-setup, not requested from a public CA.
	auto_https off
}

(local_tls) {
	bind {$MOTET_CADDY_BIND:127.0.0.1}
	tls {$MOTET_TLS_CERT} {$MOTET_TLS_KEY}
}

(forwarded_headers) {
	# None of the incoming proxy headers may assert the browser's identity.
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto https
	header_up X-Forwarded-Port 443
	header_up -Forwarded
}

https://motet.test {
	import local_tls

	@api path /xrpc/* /oauth/*
	handle @api {
		reverse_proxy 127.0.0.1:2583 {
			import forwarded_headers
		}
	}
	handle {
		reverse_proxy {$MOTET_WEB_UPSTREAM:127.0.0.1:4174} {
			import forwarded_headers
		}
	}
}

https://pds.motet.test, https://*.pds.motet.test {
	import local_tls
	reverse_proxy 127.0.0.1:4800 {
		import forwarded_headers
	}
}

https://tenor.motet.test, https://*.motet.test {
	import local_tls
	reverse_proxy 127.0.0.1:2584 {
		import forwarded_headers
	}
}

https://plc.motet.test {
	import local_tls
	reverse_proxy 127.0.0.1:2582 {
		import forwarded_headers
	}
}

https://relay.motet.test {
	import local_tls
	reverse_proxy 127.0.0.1:2470 {
		import forwarded_headers
	}
}

https://tap.motet.test {
	import local_tls
	reverse_proxy 127.0.0.1:2480 {
		import forwarded_headers
	}
}
