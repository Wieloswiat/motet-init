{
  "lexicon": 1,
  "id": "at.motet.pilot.character",
  "description": "DRAFT. A character, in its player's repo. Where a World requires approval, it counts once an approval decision names this version.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
          "summary": { "type": "string", "maxLength": 8192, "description": "Typst source." },
          "portrait": { "type": "blob", "accept": ["image/png", "image/jpeg", "image/webp"], "maxSize": 2000000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
