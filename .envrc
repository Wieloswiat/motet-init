# direnv: enter the devenv shell defined in flake.nix. nix-direnv is
# recommended (it caches the evaluation); plain direnv works too.
# devenv needs impure evaluation to find the project root.
watch_file flake.nix flake.lock nix/*.nix nix/pkgs/*.nix nix/patches/*.patch nix/network-smoke.py rust-toolchain.toml
use flake . --no-pure-eval
